# Copy this file to .env and fill in real values for local development.
# On Render, set these as Environment Variables in the dashboard.

NODE_ENV=development

# Frontend URL for CORS — set to your Vercel URL in production
# Example: https://your-app.vercel.app
FRONTEND_URL=

BREVO_API_KEY=
SCHOOL_EMAIL=

GROQ_API_KEY=
CARTESIA_API_KEY=

SESSION_SECRET=
